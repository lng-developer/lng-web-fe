# URL gốc của API backend, dùng trong src/services/axiosInstance.js
# Development: xem .env.development
# Production: xem .env.production
VITE_API_BASE_URL=

# Optional HTTPS backend origin for multipart uploads.
# Leave empty to use VITE_API_BASE_URL.
VITE_UPLOAD_API_BASE_URL=

# Tên hiển thị của ứng dụng
VITE_APP_NAME=LNG Web FE

# Microsoft OAuth
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common
