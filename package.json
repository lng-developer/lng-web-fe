{
  "name": "lng-web-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdev --host 0.0.0.0 --port 5173",
    "dev:server": "vite --mode development --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "performance:bundle": "node scripts/performance/bundle-report.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:ci",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui --maxWorkers=2",
    "test:ui:ci": "vitest run --project ui --maxWorkers=2",
    "test:portal": "vitest run src/test/portal --project unit && vitest run src/test/portal --project ui --maxWorkers=4",
    "test:ci": "npm run test:unit && npm run test:ui",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "antd": "^6.5.2",
    "axios": "^1.17.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.5.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,html}": [
      "prettier --write"
    ]
  }
}
